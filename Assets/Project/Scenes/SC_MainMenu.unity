    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uACF5\uAC1C 60\uCD08 \u2192 \uBE44\uACF5\uAC1C 30\uCD08 \u2192 \uAC70\uB798
    \uC2DC\uAC04 30\uCD08\n\uACF5\uAC1C: \uCD5C\uACE0 \uC785\uCC30\uBCF4\uB2E4 $1
    \uC774\uC0C1 \uB192\uAC8C / \uCD5C\uACE0 \uC785\uCC30 \uCDE8\uC18C \uBD88\uAC00\n\uBE44\uACF5\uAC1C:
    \uB9C8\uAC10 \uC804 \uC218\uC815 \uAC00\uB2A5 / C\uB85C \uCDE8\uC18C \uAC00\uB2A5\n\n\uB3D9\uC561\uC774\uBA74
    \uD604\uC7AC \uAE08\uC561\uC744 \uBA3C\uC800 \uC81C\uCD9C\uD55C \uC0AC\uB78C\uC774
    \uC6B0\uC120\uD569\uB2C8\uB2E4.\n\uAE08\uC561\uC744 \uBC14\uAFB8\uBA74 \uC6B0\uC120
    \uC2DC\uAC01\uB3C4 \uAC31\uC2E0\uB429\uB2C8\uB2E4.\n\uC785\uCC30\uAE08\uC740
    \uC608\uC57D\uB429\uB2C8\uB2E4. Q \uD1F4\uC11D\uC740 \uC785\uCC30 \uCDE8\uC18C\uAC00
    \uC544\uB2D9\uB2C8\uB2E4.\n\uBE44\uACF5\uAC1C \uACB0\uACFC\uB294 \uBCF8\uC778\uC758
    \uC131\uACF5\xB7\uC2E4\uD328\uB9CC \uD655\uC778\uD569\uB2C8\uB2E4."
