  m_FontData:
    m_Font: {fileID: 12800000, guid: cbb59ffd2422a954b966e65793fe5532, type: 3}
    m_FontSize: 27
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "17\uB77C\uC6B4\uB4DC \uB3D9\uC548 \uC8FC\uC2DD \uAC70\uB798\uC640 \uC815\uBCF4
    \uACBD\uB9E4\uB85C \uC790\uC0B0\uC744 \uB298\uB9AC\uC138\uC694.\n\n\uC2DC\uC791
    \uD604\uAE08 $200 \xB7 \uD68C\uC0AC\uBCC4 \uC2DC\uC791 \uC778\uC6D0 \xD7 4\uC8FC\n\uACBD\uB9E4
    \uB77C\uC6B4\uB4DC: 2 \xB7 6 \xB7 10 \xB7 14\n\uC815\uBCF4\uB97C \uD65C\uC6A9\uD574
    \uB9E4\uC218\xB7\uB9E4\uB3C4\uD558\uAC70\uB098 \uD558\uB77D\uC5D0 \uBCA0\uD305\uD558\uC138\uC694.\n\n\uCD5C\uC885
    \uC810\uC218 = \uD604\uAE08 + \uBCF4\uC720 \uC8FC\uC2DD\uC758 \uCD5C\uC885 \uAC00\uCE58\n\uB3D9\uC810\uC774\uBA74
    \uBCF4\uC720 \uC8FC\uC2DD \uC218, \uADF8\uAC83\uB3C4 \uAC19\uC73C\uBA74 \uACF5\uB3D9
    \uC6B0\uC2B9"
